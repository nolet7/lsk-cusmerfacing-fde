# PUBLIC BUILD SETTINGS ONLY — never put secrets/tokens in Vite variables.
VITE_ENTRA_TENANT_ID=<approved-entra-tenant-guid>
VITE_ENTRA_SPA_CLIENT_ID=<registered-spa-client-id>
